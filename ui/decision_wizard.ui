}
QPushButton#backBtn:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #c75c47, stop:1 #b71c1c);
}
QPushButton#cancelBtn {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #e17055, stop:1 #d63031);
}
QPushButton#cancelBtn:hover {
